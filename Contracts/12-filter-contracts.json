      }
    },
    "Polarity": {
      "parameters": {
        "inverted": "boolean"
      }
    },
    "HighPassFilter": {
      "parameters": {
        "family": "Butterworth | LinkwitzRiley | Bessel",
        "order": "integer",
        "frequency": "Hz"
      }
    },
    "LowPassFilter": {
      "parameters": {
        "family": "Butterworth | LinkwitzRiley | Bessel",
        "order": "integer",
        "frequency": "Hz"
      }
    },
    "ParametricEQ": {
      "parameters": {
        "frequency": "Hz",
        "gain": "dB",
        "q": "number"
      }
    }
  },
  "v1Required": [
    "Gain",
    "Delay",
    "Polarity",
    "HighPassFilter",
    "LowPassFilter",
    "ParametricEQ"
