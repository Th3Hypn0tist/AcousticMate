{
  "base": {
    "module": "SignalProcessor",
    "scope": "AcousticMate",
    "instantiable": true,
    "data": {
      "id": "string",
      "enabled": "boolean"
    },
    "contract": {
      "transfer": "function(frequencyHz) => complex"
    }
  },
  "processors": {
