{
  "module": "CrossoverNetwork",
  "scope": "AcousticMate",
  "instantiable": true,
  "inputs": {
    "routes": "CrossoverRoute[]"
  },
  "route": {
    "id": "string",
    "targets": "Speaker[] | SpeakerGroup",
    "signalChain": "SignalChain"
  },
  "operations": [
    "addRoute",
    "removeRoute",
    "assignSpeaker",
    "unassignSpeaker",
    "setSignalChain"
  ],
  "rules": [
    "crossover is routing plus signal chains, not a special acoustic solver",
    "different speakers may use different crossover points, delays, gains and polarity"
  ]
}
